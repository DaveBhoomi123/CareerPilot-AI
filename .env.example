DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Empty uses SQLite locally. Production requires PostgreSQL with SSL.
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Read-inactivity timeout in seconds (1–60); connection timeout remains 5 seconds.
GEMINI_READ_TIMEOUT_SECONDS=60
AI_DAILY_LIMIT=15

# Email: DEBUG=True always uses console. Production defaults to SMTP.
# Set these privately in Render; leave local values blank for console testing.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# Optional HTTPS email backend: assistant.email_backends.BrevoEmailBackend
# Only needed with that backend; use a verified DEFAULT_FROM_EMAIL sender.
BREVO_API_KEY=
